# Copy to backend/.env and fill in. That file is gitignored; keep it mode 600.
#
#   cp backend/.env.example backend/.env && chmod 600 backend/.env
#
# Values already present in the real environment take precedence over this file, so a
# deployment can override any of it without editing. The diesel CLI also reads backend/.env,
# which is why DATABASE_URL lives here.

# ---------------------------------------------------------------- database

DATABASE_URL=postgres://postgres:PASSWORD@localhost:5432/pchan_v2

# ---------------------------------------------------------------- site

# Public origin, no trailing slash. Must match the Auth0 callback URL below.
PUBLIC_URL=https://pchan.p51.nl

# Marks the session cookie Secure. Keep true in production. Set false ONLY to exercise the
# site over plain HTTP locally; startup refuses false together with an https PUBLIC_URL.
COOKIE_SECURE=true

# ---------------------------------------------------------------- auth0
#
# From the Auth0 application's Settings tab. Create it as a **Regular Web Application**
# (confidential client) — not a SPA: the code exchange happens in the backend, and the WASM
# frontend never talks to Auth0 directly.

# If the tenant has an Auth0 custom domain, set it here (e.g. login.example.com) rather than
# the tenant's *.auth0.com name. The authorize, token and JWKS URLs and the expected token
# issuer are all derived from this one value, and a custom-domain tenant issues tokens whose
# `iss` is the custom domain, so using the tenant name there fails verification.
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=

# ---------------------------------------------------------------- keys
#
# Generate each one SEPARATELY:
#
#   openssl rand -hex 32
#
# Startup refuses to boot if any is under 32 bytes or if any two are equal.
#
# These are what keep a database dump from being a deanonymisation tool: with them, a dump
# links a join request to a member and a member to their posts; without them it does not.
# Guard them like the identity table itself, and keep them OUT of the repo and out of backups
# that sit next to a database dump.
#
# Rotating one is not free:
#   IDENTITY_KEY        rotating locks every member out (their Auth0 subject stops resolving)
#   REQUEST_KEY         rotating orphans pending join requests and declines
#   POST_AUTHOR_KEY     rotating makes every existing post undeletable by its author
#   INVITE_KEY          rotating revokes every board invite and moderator grant
#   PUSH_ENCRYPTION_KEY rotating makes stored push subscriptions unreadable

IDENTITY_KEY=
REQUEST_KEY=
POST_AUTHOR_KEY=
INVITE_KEY=
PUSH_ENCRYPTION_KEY=
